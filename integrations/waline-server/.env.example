# Keep locked until account, security, database and restore acceptance is complete.
WALINE_MODE=locked
# Use the Neon runtime role, not the schema/backup owner's credentials.
# Pooled host for the API. Replace sslmode=require with sslmode=verify-full.
WALINE_DATABASE_URL=postgresql://waline_app:REPLACE@ep-REPLACE-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
WALINE_JWT_TOKEN=
WALINE_BLOG_ORIGIN=https://blog.example.com
WALINE_PANEL_ORIGIN=https://comments.example.com
WALINE_API_ORIGIN=https://waline.example.com
# Only in protected bootstrap mode; remove before public mode.
WALINE_SETUP_PASSWORD=
# Do not configure SMTP, notification, OAuth or other storage variables.
# Maintenance/backup owner connection belongs in a SEPARATE local env file,
# never in Vercel: WALINE_BACKUP_DATABASE_URL (direct, non-pooler, verify-full).
